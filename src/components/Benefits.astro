---
import SectionNumber from "./SectionNumber.astro";

const benefits = [
  {
    title: "Спокойствие и свободная голова",
    text: "Больше не нужно держать десятки мелких деталей в уме — приложение берет рутину памяти на себя.",
  },
  {
    title: "Репутация внимательного человека",
    text: "Друзья и партнеры оценят, что вы искренне помните их увлечения, имена детей и важные для них даты.",
  },
  {
    title: "Глубокие и теплые связи",
    text: "Вы регулярно проявляете внимание вовремя, восстанавливаете забытые контакты и укрепляете социальный капитал.",
  },
  {
    title: "Порядок вместо хаоса",
    text: "Вся информация собрана в одном интерфейсе и доступна в любую секунду.",
  },
];
---

<section class="border-t border-line">
  <div class="mx-auto box-content flex max-w-page flex-col gap-6 px-6 py-14 lg:gap-10 lg:py-24">
    <SectionNumber number="03" />
    <h2 class="font-serif text-28 leading-115 font-bold lg:max-w-benefits-title lg:text-h2">
      Что меняется, когда у отношений появляется система
    </h2>
    <ul class="grid gap-7 lg:grid-cols-2 lg:gap-x-12 lg:gap-y-10">
      {
        benefits.map((benefit) => (
          <li class="flex min-w-0 flex-col gap-2 lg:gap-2.5">
            {/* items-start keeps the icon on the first line when the title wraps */}
            <h3 class="flex items-start gap-2.5 text-18 leading-130 font-bold text-paper lg:gap-3 lg:text-20">
              <svg
                class="size-5.5 shrink-0 text-accent lg:size-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M8 12.5l2.8 2.8L16 10"></path>
              </svg>
              {benefit.title}
            </h3>
            <p class="text-15 leading-155 text-muted lg:ml-9 lg:text-16">{benefit.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
