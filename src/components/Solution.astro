---
import SectionNumber from "./SectionNumber.astro";

// Icons are the inner SVG markup from Design/reference/
const features = [
  {
    title: "Умные профили контактов",
    text: "Храните не просто номер телефона, а контекст: хобби, привычки, предпочтения в еде, совместные воспоминания и историю общения.",
    icon: '<rect x="3" y="4" width="18" height="16" rx="3"></rect><circle cx="9" cy="11" r="2.5"></circle><path d="M5.5 17c.6-1.8 2-2.8 3.5-2.8s2.9 1 3.5 2.8M15 9h3M15 13h3"></path>',
  },
  {
    title: "Напоминания о событиях",
    text: "Приложение заранее подскажет о дне рождения, годовщине или запланированном созвоне — вы всегда успеете подготовить подарок или теплое поздравление.",
    icon: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"></path>',
  },
  {
    title: "Быстрые заметки «на бегу»",
    text: "Записывайте важные мелочи сразу после встречи или разговора буквально в два клика.",
    icon: '<path d="M4 20h4L19 9l-4-4L4 16z"></path><path d="M13.5 6.5l4 4"></path>',
  },
  {
    title: "Гибкие теги и фильтры",
    text: "Группируйте людей по контексту: «университет», «клиенты», «спортзал», «настольные игры» или «семья».",
    icon: '<path d="M3 12V4h8l10 10-8 8z"></path><circle cx="7.5" cy="8.5" r="1.5"></circle>',
  },
];
---

<section class="border-t border-line">
  {/* Desktop columns grow 5 : 8, the same 1 : 1.6 split as the reference */}
  <div class="mx-auto box-content flex max-w-page flex-col gap-6 px-6 py-14 lg:flex-row lg:items-start lg:gap-20 lg:py-24">
    <div class="flex min-w-0 flex-col gap-6 lg:grow-5 lg:basis-85">
      <SectionNumber number="02" />
      <h2 class="font-serif text-28 leading-115 font-bold lg:text-h2">
        Ваша <span class="text-accent italic">вторая память</span> для крепких личных и рабочих связей
      </h2>
    </div>
    <ul class="flex min-w-0 flex-col lg:grow-8 lg:basis-130">
      {
        features.map((feature) => (
          <li class="flex gap-4 border-t border-line py-5 last:border-b lg:gap-5 lg:py-6.5">
            <svg
              class="size-6.5 shrink-0 text-accent lg:size-7"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={feature.icon}
            />
            <div class="flex flex-col gap-1.5 lg:gap-2">
              <h3 class="text-17 font-bold lg:text-20">{feature.title}</h3>
              <p class="text-15 leading-150 text-muted lg:text-16 lg:leading-155">{feature.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
